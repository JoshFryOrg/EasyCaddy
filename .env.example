# Copy to `.env` for local work. `.env` is git-ignored.

# Host ports. Change these if 80/443 are already in use on your machine.
HTTP_PORT=80
HTTPS_PORT=443

# The WAF's settings (README.md, "Web application firewall"). Uncomment one to change it; left commented, the default applies.
#EASYCADDY_WAF_MODE=
#EASYCADDY_WAF_PROFILE=
#EASYCADDY_WAF_PARANOIA=
#EASYCADDY_WAF_ANOMALY_THRESHOLD=
#EASYCADDY_WAF_BODY_INSPECT_BYTES=
