# Copy to `.env` for local work. `.env` is git-ignored.

# Host ports. Change these if 80/443 are already in use on your machine.
HTTP_PORT=80
HTTPS_PORT=443

# Cloudflare API token with Zone:DNS:Edit, used by the Caddyfile for DNS challenges. Only needed if your
# Caddyfile references {env.CLOUDFLARE_API_TOKEN}.
CLOUDFLARE_API_TOKEN=
