# Copy to `.env` (git-ignored) next to docker-compose.yml. Changes take effect on `docker compose up -d`.

# Host ports, for local development with this repo's docker-compose.yml.
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------------------------------------------------------------
# Web application firewall (Coraza with the OWASP Core Rule Set). See docs/waf.md.
#
# Off until you opt in. To turn it on:
#   1. In your Caddyfile, `import /usr/share/easycaddy/waf.caddy` once, and `invoke waf` in each site to protect.
#   2. Here, uncomment EASYCADDY_WAF_MODE=On.
#
# Leave a line commented to keep its default. Don't leave one uncommented and empty: an empty value replaces the
# default and breaks the WAF's config.
# ---------------------------------------------------------------------------------------------------------------------

# What the WAF does with a request its rules match.
#   Off            Default. Lets everything through, even on sites with `invoke waf`.
#   DetectionOnly  Lets everything through but logs each match: run a while on this first, check the logs for false
#                  positives (normal traffic the rules match), then switch to On.
#   On             Blocks matching requests with a 403.
#EASYCADDY_WAF_MODE=On

# Which policy the rules apply on top of their attack detection.
#   selfhosted  Default. Also allows what self-hosted apps need: PUT, PATCH and DELETE (registries, Plex, file apps,
#               APIs); raw binary uploads (left unread), plain text and Docker/OCI image manifests; and the
#               `Expect: 100-continue` and `Content-Range` headers large and resumable uploads send.
#   strict      The Core Rule Set's stock policy: only GET, HEAD, POST and OPTIONS, and only form, JSON and XML
#               bodies. For plain websites; breaks registry pushes and many file and media apps.
#EASYCADDY_WAF_PROFILE=selfhosted

# How suspicious the rules are, 1 to 4. Default 1: few false positives. Each level up catches more attacks and blocks
# more normal traffic; above 2 expect to tune rules for each app.
#EASYCADDY_WAF_PARANOIA=1

# The score at which a request is blocked. Each matched rule adds to it (a critical match adds 5). Default 5: one
# critical match blocks. Raise it (10, 15) to block only requests that match several rules, for fewer false positives.
#EASYCADDY_WAF_ANOMALY_THRESHOLD=5

# How many bytes of each request body are inspected. Default 1048576 (1 MiB). The rest streams on to the app
# uninspected, so a 50 GB upload costs this much memory, not 50 GB. Raising it inspects more of each body but holds
# that much memory per upload in flight.
#EASYCADDY_WAF_BODY_INSPECT_BYTES=1048576

# Extra Coraza directives, applied after the rules. Each blocked request is logged with its rule's id
# ([id "942100"]); switch off one that blocks normal traffic with SecRuleRemoveById. For several, put them in double
# quotes, one per line.
#EASYCADDY_WAF_DIRECTIVES=SecRuleRemoveById 942100
